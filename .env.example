DATABASE_URL=sqlite:///./plantlive.db
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava:7b
ENABLE_LOCAL_AI=true
PLANT_ID_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
SESSION_DAYS=30
DAILY_DIAGNOSIS_LIMIT=20
ADMIN_EMAIL=admin@plantlive.es
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@plantlive.es
# Copiar la pública también a frontend/.env como VITE_VAPID_PUBLIC_KEY

# Correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PlantLive <avisos@plantlive.es>

# Despliegue gratuito
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=plant-photos
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=PlantLive <soporte@plantlive.es>
EMAIL_REPLY_TO=plantlivesupport@gmail.com
