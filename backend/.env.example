# Modelos locales de Ollama usados por PlantLive
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_VISION_MODEL=gemma3:4b

# Análisis avanzado opcional. Si faltan, PlantLive utiliza Gemma local.
PLANT_ID_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Producción
DATABASE_URL=sqlite:///./plantlive.db
PUBLIC_APP_URL=http://localhost:5173

# Proveedores futuros para avisos con la app cerrada
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Almacenamiento de fotografías en producción
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
